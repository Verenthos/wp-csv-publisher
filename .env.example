# Copy to .env and fill in. Never commit .env.
# Run with: npm start -- articles.csv   (uses node --env-file=.env)

# Site root, no trailing slash. For the local mock server: http://localhost:8080
WP_BASE_URL=https://example-client-site.com

# WordPress user that owns the posts. Use a dedicated Editor user, not an admin.
WP_USERNAME=

# Application Password generated for that user (Users > Profile > Application Passwords).
WP_APP_PASSWORD=

# Optional tuning (defaults shown)
# Minimum gap between two requests to the API, in milliseconds (500 = at most 2 requests/second)
WP_MIN_REQUEST_INTERVAL_MS=500
# How many times a transient failure (5xx, 429, timeout, network error) is retried per request
WP_MAX_RETRIES=3
# Per-request timeout in milliseconds
WP_REQUEST_TIMEOUT_MS=15000
